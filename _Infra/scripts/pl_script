	insert into parameters(pack_id, type_parameter_code, value) values
	(1, 1, 100), (1, 2, 15), (1, 3, 750), (1, 4, 30), (1, 5, 5),
	(2, 1, 100), (2, 2, 15), (2, 3, 750), (2, 4, 15), (2, 6, 12),
	(3, 1, 120), (3, 2, 22), (3, 3, 740), (3, 4, 45), (3, 5, 8),
	(4, 1, 85),  (4, 2, -5), (4, 3, 765), (4, 4, 10), (4, 6, 20);
end $$;

-- связи и ограничения
do $$
begin
	alter table users drop constraint if exists fk_users_position;
	alter table users add constraint fk_users_position
		foreign key (position_id) references positions(code);

	alter table packs drop constraint if exists fk_packs_user;
	alter table packs add constraint fk_packs_user
		foreign key (user_id) references users(code);

	alter table packs drop constraint if exists fk_packs_equipment_type;
	alter table packs add constraint fk_packs_equipment_type
		foreign key (equipment_type_id) references types_of_equipment(code);

	alter table parameters drop constraint if exists fk_parameters_pack;
	alter table parameters add constraint fk_parameters_pack
		foreign key (pack_id) references packs(code);

	alter table parameters drop constraint if exists fk_parameters_type_parameter;
	alter table parameters add constraint fk_parameters_type_parameter
		foreign key (type_parameter_code) references type_parameters(code);

	alter table type_parameters drop constraint if exists fk_type_parameters_unit;
	alter table type_parameters add constraint fk_type_parameters_unit
		foreign key (id_unit) references units_of_measurement(code);

	alter table units_of_measurement drop constraint if exists fk_units_base_unit;
	alter table units_of_measurement add constraint fk_units_base_unit
		foreign key (base_unit_code) references base_units_of_measurement(code);

	alter table type_parameters drop constraint if exists chk_type_parameters_min_max;
	alter table type_parameters add constraint chk_type_parameters_min_max
		check (min_value is null or max_value is null or min_value <= max_value);
end $$;
