-- создание структуры таблиц + счетчики
do $$
begin
	create sequence if not exists seq_types_of_equipment;
	create sequence if not exists seq_positions;
	create sequence if not exists seq_users;
	create sequence if not exists seq_packs;
	create sequence if not exists seq_parameters;
	create sequence if not exists seq_base_units_of_measurement;
	create sequence if not exists seq_units_of_measurement;
	create sequence if not exists seq_type_parameters;

	create table if not exists types_of_equipment (
		code int primary key default nextval('seq_types_of_equipment'),
		type text not null
	);

	create table if not exists positions (
		code int primary key default nextval('seq_positions'),
		title text not null
	);

	create table if not exists users (
		code int primary key default nextval('seq_users'),
		full_name text not null,
		position_id int not null
	);

	create table if not exists packs (
		code int primary key default nextval('seq_packs'),
		user_id int not null,
		equipment_type_id int not null,
		created_at timestamp not null default current_timestamp
	);

	create table if not exists base_units_of_measurement (
		code int primary key default nextval('seq_base_units_of_measurement'),
		name_base_unit varchar(100) not null,
		symbol_base varchar(12) not null
	);

	create table if not exists units_of_measurement (
		code int primary key default nextval('seq_units_of_measurement'),
		name_unit varchar(100) not null,
		symbol varchar(10),
		base_unit_code int
	);

	create table if not exists type_parameters (
		code int primary key default nextval('seq_type_parameters'),
		name_type_parameter varchar(100) not null,
		id_unit int not null,
		min_value numeric,
		max_value numeric
	);

	create table if not exists parameters (
		code int primary key default nextval('seq_parameters'),
		pack_id int not null,
		type_parameter_code int not null,
		value numeric not null
	);
end $$;

-- заполнение тестовыми данными
do $$
begin
	insert into types_of_equipment(type) values
	('ДМК'),
	('ВР');

	insert into positions(title) values
	('Рядовой'),
	('Сержант'),
	('Мл. Сержант'),
	('Ст. Сержант'),
	('Лейтенант');

	insert into users(full_name, position_id) values
	('Иванов Иван Иванович', 1),
	('Петров Пётр Петрович', 2),
	('Сидоров Сидор Сидорович', 5),
	('Попов Павел Павлович', 3);

	insert into packs(user_id, equipment_type_id) values
	(1, 1),
	(2, 2),
	(3, 1),
	(4, 2);

	insert into base_units_of_measurement(name_base_unit, symbol_base) values
	('Длина', 'м'),
	('Температура', '°C'),
	('Давление', 'мм рт. ст.'),
	('Скорость', 'м/с'),
	('Угол', 'д.у.');

	insert into units_of_measurement(name_unit, symbol, base_unit_code) values
	('Метр', 'м', 1),
	('Градус Цельсия', '°C', 2),
	('Миллиметр ртутного столба', 'мм рт. ст.', 3),
	('Метр в секунду', 'м/с', 4),
	('Деление угломера', 'д.у.', 5);

	insert into type_parameters(name_type_parameter, id_unit, min_value, max_value) values
	('Высота метеопоста', 1, null, null),
	('Температура', 2, -58, 58),
	('Давление', 3, 500, 900),
	('Направление ветра', 5, 0, 59),
	('Скорость ветра', 4, 0, 15),
